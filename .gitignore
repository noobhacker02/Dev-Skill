# Editors / OS
.DS_Store
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node (target repos this skill is used on may have these; harmless to ignore here too)
node_modules/

# Environment files — the whole point of this skill is that these never get committed
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist

# Local, per-clone git config artifacts (core.hooksPath points at tracked .githooks/, not this)
*.local
